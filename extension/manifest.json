{
  "manifest_version": 3,
  "name": "ChatGPT Web Driver",
  "version": "0.1.0",
  "description": "Programmatic ChatGPT Web adapter extracted from the proven Watchdog control path.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "dist/extension/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content-script-loader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["client-relay-loader.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/*.js",
        "dist/client/*.js",
        "dist/extension/*.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ]
    }
  ],
  "action": {
    "default_title": "ChatGPT Web Driver",
    "default_popup": "debug.html"
  }
}
